    {"id":"missing_license","target":"source","path":"license_id","value":"","expected_code":"OSM_KB_LICENSE_MISSING"},
    {"id":"empty_name","target":"entry","path":"name_en","value":"","expected_code":"OSM_KB_REQUIRED_TEXT_EMPTY"},
    {"id":"empty_description","target":"entry","path":"description_zh","value":"","expected_code":"OSM_KB_REQUIRED_TEXT_EMPTY"},
