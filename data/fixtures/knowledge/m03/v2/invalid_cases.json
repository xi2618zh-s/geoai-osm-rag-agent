    {"id":"invalid_status","target":"entry","path":"status","value":"widely_used","expected_code":"OSM_KB_STATUS_INVALID"},
    {"id":"hard_negative_self","target":"entry","mutation":"hard_negative_self","expected_code":"OSM_KB_HARD_NEGATIVE_SELF_REFERENCE"},
