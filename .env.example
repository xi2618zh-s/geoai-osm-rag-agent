# Copy selected values into your shell environment. The application does not
# automatically load this file, so no secret is read implicitly.

GEOAI_OSM_PBF=data/osm/sweden-latest.osm.pbf
GEOAI_OUTPUT_DIR=output
GEOAI_CACHE_DIR=.cache

GEOAI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEOAI_RETRIEVAL_MODE=hybrid
GEOAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
GEOAI_OLLAMA_MODEL=qwen2.5:3b
GEOAI_OLLAMA_TIMEOUT_S=180

GEOAI_NOMINATIM_USER_AGENT=GeoAI-OSM-RAG/2.0 (portfolio project; add your contact)
GEOAI_FLASK_HOST=127.0.0.1
GEOAI_FLASK_PORT=8000
GEOAI_FLASK_DEBUG=0
